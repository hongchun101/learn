{
  "name": "network-learning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A complete, code-first curriculum that takes you from zero to expert in network protocols and distributed systems. Twelve chapters, each backed by runnable TypeScript modules with unit tests, that walk from raw bit-level framing to consensus, replication, and observability.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.ts\"",
    "build": "tsc -p tsconfig.build.json",
    "demo": "tsx scripts/run-all-demos.ts"
  },
  "dependencies": {
    "protobufjs": "7.4.0"
  },
  "devDependencies": {
    "@eslint/js": "9.17.0",
    "@types/node": "22.10.2",
    "@typescript-eslint/eslint-plugin": "8.18.1",
    "@typescript-eslint/parser": "8.18.1",
    "@vitest/coverage-v8": "2.1.8",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  }
}
