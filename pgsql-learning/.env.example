# PostgreSQL connection strings used by scripts/*
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=learning

# Replica (for HA / streaming-replication modules)
REPLICA_HOST=localhost
REPLICA_PORT=5433
REPLICA_USER=postgres
REPLICA_PASSWORD=postgres

# Backup target directory
BACKUP_DIR=./data/backups
WAL_ARCHIVE_DIR=./data/wal_archive

# pgAdmin
PGADMIN_EMAIL=admin@local
PGADMIN_PASSWORD=admin
