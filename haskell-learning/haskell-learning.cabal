cabal-version:      2.2
name:               haskell-learning
version:            0.1.0.0
synopsis:           A from-zero-to-expert Haskell learning curriculum.
description:        Run the demos with `cabal run haskell-learning-demo`.
license:            MIT
author:             hongchun
maintainer:         1251341510@qq.com
build-type:         Simple

library
    hs-source-dirs:      src
    default-extensions:  ScopedTypeVariables, BangPatterns, OverloadedStrings,
                         TypeFamilies, GADTs, RankNTypes, ExistentialQuantification,
                         TypeOperators, FlexibleContexts
    ghc-options:         -Wall -Wno-name-shadowing
    build-depends:       base >= 4.14 && < 5
                      , text
                      , containers
                      , mtl
                      , bytestring
                      , array
    exposed-modules:
        Basics
      , ListsStrings
      , HigherOrder
      , TypesClasses
      , MonoidsFoldable
      , FunctorsApplicatives
      , MonadsTransformers
      , IOChapter
      , Parsing
      , Concurrency
      , Advanced
      , Expert

executable haskell-learning-demo
    main-is:          Main.hs
    hs-source-dirs:   src
    ghc-options:      -Wall -threaded -rtsopts
    build-depends:    base >= 4.14 && < 5
                    , text
                    , containers
                    , mtl
                    , transformers
                    , bytestring
                    , array
                    , haskell-learning

test-suite haskell-learning-test
    main-is:          Test.hs
    hs-source-dirs:   tests
    ghc-options:      -Wall
    build-depends:    base >= 4.14 && < 5
                    , text
                    , containers
                    , mtl
                    , transformers
                    , bytestring
                    , tasty
                    , tasty-hunit
                    , tasty-quickcheck
                    , QuickCheck
                    , array
                    , haskell-learning
