cabal-version:      2.4
name:               cp-haskell
version:            0.1.0.0
synopsis:           Concurrency & parallelism curriculum
license:            BSD-3-Clause
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:
    Cp.Ch01MVar
    Cp.Ch02Chan
    Cp.Ch03Async
    Cp.Ch04STM
    Cp.Ch05Parallel
    Cp.Ch06Atomics
    Cp.Ch07Structured
    Cp.Ch08Threads
    Cp.Ch09Patterns
  build-depends:
    base       >= 4.18 && < 5,
    async      >= 2.2,
    stm        >= 2.5,
    containers >= 0.6,
    vector     >= 0.13,
    parallel   >= 3.2,
    deepseq    >= 1.4,
    atomic-primops >= 0.8
  default-language:  Haskell2010
  ghc-options:       -Wall -threaded -rtsopts -with-rtsopts=-N4

executable cp-haskell
  hs-source-dirs:   app
  main-is:          Main.hs
  build-depends:
    base, cp-haskell, vector
  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N4

test-suite cp-haskell-test
  type:             exitcode-stdio-1.0
  hs-source-dirs:   test
  main-is:          Spec.hs
  build-depends:
    base,
    cp-haskell,
    hspec          >= 2.10,
    QuickCheck     >= 2.15
  default-language: Haskell2010
  ghc-options:      -threaded -rtsopts -with-rtsopts=-N4
