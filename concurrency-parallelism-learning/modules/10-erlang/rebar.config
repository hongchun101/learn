{erl_opts, [debug_info,
            warnings_as_errors,
            warn_unused_vars,
            warn_export_all,
            warn_shadow_vars,
            warn_unused_import,
            warn_obsolete_guard]}.

{deps, []}.

{relx, [{release, {cp, "0.1.0"},
         [cp,
          sasl]},
        {sys_config, "./config/sys.config"},
        {vm_args,    "./config/vm.args"},
        {dev_mode,   true},
        {include_erts, false},
        {extended_start_script, true}]}.

{cover_enabled, true}.
{eunit_opts, [verbose]}.

{profiles, [
  {test, [
    {erl_opts, [nowarn_export_all]}
  ]}
]}.
